    "@hocuspocus/transformer": "4.5.0",
    "@keyv/redis": "5.1.6",
    "@lec/doc-editor": "file:../../packages/lec-doc-editor",
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs-labs/nestjs-ioredis": "11.0.4",
    "@nestjs/bullmq": "11.0.5",
